#!/usr/bin/env bash
set -euo pipefail

ENV_NAME="sgar_ddi"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v conda >/dev/null 2>&1; then
    echo "[ERROR] Conda was not found. Install Miniconda or Anaconda first."
    exit 1
fi

source "$(conda info --base)/etc/profile.d/conda.sh"

if conda env list | awk '{print $1}' | grep -qx "${ENV_NAME}"; then
    echo "[INFO] Updating existing environment: ${ENV_NAME}"
    conda env update --name "${ENV_NAME}" --file "${REPO_DIR}/environment.yml" --prune
else
    echo "[INFO] Creating environment: ${ENV_NAME}"
    conda env create --file "${REPO_DIR}/environment.yml"
fi

echo "[OK] Installation completed."
echo "Activate with:"
echo "source \"\$(conda info --base)/etc/profile.d/conda.sh\""
echo "conda activate ${ENV_NAME}"
